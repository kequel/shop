# Archiwa i śmieci systemowe
*.tar
*.gz
*.zip
*~
.DS_Store
.idea/
.vscode/

# Python & Scraper
venv/
__pycache__/
*.pyc
scraping_results/product_images/

# Logi i dane Dockera
*.log
volumes/
config_files_and_scripts/volumes
config_files_and_scripts/db_data/
config_files_and_scripts/backup/*.sql

# CACHE 
/store_source_code/cache/*
!/store_source_code/cache/.htaccess
!/store_source_code/cache/index.php

# DOWNLOAD & UPLOAD
/store_source_code/download/*
!/store_source_code/download/.htaccess
/store_source_code/upload/*
!/store_source_code/upload/.htaccess

# IMAGES
/store_source_code/img/c/*
!/store_source_code/img/p/index.php
!/store_source_code/img/c/index.php

# DEPENDENCIES
/store_source_code/bower_components/
/store_source_code/node_modules/
/store_source_code/composer.phar
!/store_source_code/composer.lock

# CONFIG FILES - KLUCZOWE ZMIANY TUTAJ:
!/store_source_code/config/settings.inc.php
!/store_source_code/app/config/parameters.php
/store_source_code/config/xml/*
!/store_source_code/config/xml/themes/default.xml

# SYMFONY & VAR
/store_source_code/var/cache/*
/store_source_code/var/logs/*
/store_source_code/var/sessions/*
!/store_source_code/var/cache/.gitkeep
!/store_source_code/var/logs/.gitkeep
!/store_source_code/.htaccess
